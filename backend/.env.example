# ─── Banco ───────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/barbearia_luck"

# ─── Autenticação ────────────────────────────────────────────────────────
# Gere um valor real: openssl rand -hex 32
# A aplicação recusa subir com segredo de exemplo, ou com menos de
# 32 caracteres em produção.
JWT_SECRET=""
JWT_EXPIRES_IN="7d"

# Origens permitidas no CORS, separadas por vírgula.
# Obrigatória em produção — sem ela a API não sobe.
CORS_ORIGINS="http://localhost:3000"

FRONTEND_URL="http://localhost:3000"
# URL pública da própria API. É a base do redirect_uri do OAuth, e precisa
# bater EXATAMENTE com o que estiver cadastrado no Google e no Facebook.
API_PUBLIC_URL="http://localhost:3001"
PORT=3001
NODE_ENV="development"

# ─── Login social (opcional) ─────────────────────────────────────────────
# Sem estas variáveis o botão do provedor simplesmente não aparece na tela.
# É proposital: botão que não leva a lugar nenhum custa mais confiança do
# que a ausência dele.
#
# Google  — https://console.cloud.google.com/apis/credentials
#   Criar "ID do cliente OAuth" do tipo "Aplicativo da Web" e cadastrar em
#   "URIs de redirecionamento autorizados":
#     http://localhost:3001/auth/social/google/callback
#
# Facebook — https://developers.facebook.com/apps
#   Adicionar o produto "Login do Facebook", e em "URIs de redirecionamento
#   OAuth válidos":
#     http://localhost:3001/auth/social/facebook/callback
#   O Facebook exige HTTPS fora de localhost, e o app precisa passar por
#   App Review para pedir o e-mail de quem não é testador.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# ─── Google Calendar (opcional, e independente do login social) ──────────
# Sincroniza a agenda do dono. É outro fluxo OAuth, com outros escopos.
GOOGLE_REDIRECT_URI="http://localhost:3001/auth/google/callback"

# ─── WhatsApp (opcional) ─────────────────────────────────────────────────
# Sem estas variáveis as mensagens só vão para o log do backend —
# é assim que se lê o código de OTP em desenvolvimento.
WHATSAPP_API_URL=""
WHATSAPP_API_KEY=""
WHATSAPP_INSTANCE=""

# ─── E-mail ──────────────────────────────────────────────────────────────
# OBRIGATÓRIA em produção: sem ela o reset de senha e o OTP por e-mail não
# saem, e o usuário fica sem caminho para recuperar a conta. A API recusa
# subir em produção sem esta variável.
#
# Em desenvolvimento pode ficar vazia — aí os códigos aparecem no log do
# backend, que é o mecanismo de teste.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="nao-responda@barbearialuck.com"

# ─── Testes ──────────────────────────────────────────────────────────────
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/barbearia_luck_test"
