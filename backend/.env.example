# Banco
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/barbearia_luck"

# Autenticação
# Gere um valor real: openssl rand -hex 32
# A aplicação recusa subir com segredo de exemplo ou com menos de 32 caracteres em produção.
JWT_SECRET=""
JWT_EXPIRES_IN="7d"

# Origens permitidas no CORS, separadas por vírgula.
# Obrigatória em produção — sem ela a API não sobe.
CORS_ORIGINS="http://localhost:3000"

# Integrações (opcionais em desenvolvimento)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3001/auth/google/callback"

WHATSAPP_API_URL=""
WHATSAPP_API_KEY=""
WHATSAPP_INSTANCE=""

FRONTEND_URL="http://localhost:3000"
PORT=3001
NODE_ENV="development"

# Só para os testes de integração (npm run test:db)
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/barbearia_luck_test"
